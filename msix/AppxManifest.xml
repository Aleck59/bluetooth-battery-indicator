<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10">

  <!-- TODO: Get Identity Name and Publisher from Partner Center -->
  <Identity Name="REPLACE_WITH_PARTNER_CENTER_NAME"
            Version="0.0.0.0"
            Publisher="REPLACE_WITH_PARTNER_CENTER_PUBLISHER"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Bluetooth Battery Indicator</DisplayName>
    <PublisherDisplayName>zonnedev</PublisherDisplayName>
    <Description>Monitor Bluetooth device battery levels from your system tray</Description>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
    <Capability Name="bluetooth"/>
  </Capabilities>

  <Applications>
    <Application Id="BluetoothBatteryIndicator" Executable="BluetoothBatteryIndicator.exe"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="Bluetooth Battery Indicator"
        Description="Monitor Bluetooth device battery levels"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png"
        BackgroundColor="transparent" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="BluetoothBatteryIndicator.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="BluetoothBatteryIndicatorStartup" Enabled="true" DisplayName="Bluetooth Battery Indicator" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>

<UserControl x:Class="BluetoothBatteryIndicator.Controls.SparklineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="60">
    <Grid>
        <!-- Background zones -->
        <Canvas x:Name="ZoneCanvas" ClipToBounds="True">
            <Rectangle x:Name="GreenZone" Fill="#1800FF00" Canvas.Left="0" Canvas.Top="0"/>
            <Rectangle x:Name="YellowZone" Fill="#18FFFF00"/>
            <Rectangle x:Name="RedZone" Fill="#18FF0000"/>
        </Canvas>
        <!-- Sparkline -->
        <Canvas x:Name="LineCanvas" ClipToBounds="True">
            <Polyline x:Name="SparkLine" Stroke="#6495ED" StrokeThickness="1.5"
                      StrokeLineJoin="Round"/>
        </Canvas>
    </Grid>
</UserControl>

<Window x:Class="BluetoothBatteryIndicator.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="380" Height="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Border CornerRadius="8" Margin="8"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="24,20">
            <TextBlock Text="Bluetooth Battery Indicator" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock x:Name="StatusText" Text="Checking for updates..." FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
            <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Height="6" Margin="0,0,0,6"/>
            <TextBlock x:Name="PercentText" Text="" FontSize="11" Opacity="0.5" HorizontalAlignment="Right"/>
        </StackPanel>
    </Border>
</Window>

<ui:FluentWindow x:Class="BluetoothBatteryIndicator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:BluetoothBatteryIndicator.Controls"
        Title="Bluetooth Battery Indicator"
        Width="750" Height="600"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/app.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Device List -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Devices" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ui:Button HorizontalAlignment="Right" Padding="6"
                               Icon="{ui:SymbolIcon ArrowSync20}" Appearance="Transparent"
                               Click="RefreshButton_Click" ToolTip="Refresh"/>
                </Grid>

                <ListView Grid.Row="1" x:Name="DeviceListView"
                          SelectionChanged="DeviceListView_SelectionChanged"
                          Background="Transparent" BorderThickness="0"
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,4" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding CategoryIcon}" FontSize="20"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" FontSize="14"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.6"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding BatteryText}"
                                               FontSize="16" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="12,0"
                                               Foreground="{Binding BatteryColor}"/>

                                    <ui:ToggleSwitch Grid.Column="3"
                                                     IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                     Checked="DeviceToggle_Toggled"
                                                     Unchecked="DeviceToggle_Toggled"
                                                     VerticalAlignment="Center"/>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Separator -->
            <Border Grid.Column="1" Width="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="16,0"/>

            <!-- Detail Panel -->
            <Grid Grid.Column="2" x:Name="DetailPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Device Info" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailStack">
                    <ui:Card Margin="0,4" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="DetailName" FontSize="16" FontWeight="SemiBold"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nickname" Opacity="0.6" VerticalAlignment="Center"/>
                                <ui:TextBox Grid.Column="1" x:Name="NicknameBox"
                                         LostFocus="NicknameBox_LostFocus"
                                         KeyDown="NicknameBox_KeyDown"
                                         PlaceholderText="Enter nickname..." Margin="0,0,0,4"/>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Icon" Opacity="0.6" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="CategoryCombo" SelectionChanged="CategoryCombo_SelectionChanged"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Opacity="0.6"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailType"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Address" Opacity="0.6"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailAddress"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Status" Opacity="0.6"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailStatus"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Battery" Opacity="0.6"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailBattery" FontWeight="Bold"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Paired" Opacity="0.6"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Yes"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Battery visual -->
                    <ui:Card Margin="0,8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Battery Level" FontWeight="Medium" Margin="0,0,0,8"/>
                            <ProgressBar x:Name="BatteryBar" Minimum="0" Maximum="100" Height="12"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Battery history sparkline -->
                    <ui:Card Margin="0,8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Battery History (7 days)" FontWeight="Medium" Margin="0,0,0,8"/>
                            <controls:SparklineControl x:Name="HistorySparkline" Height="60"/>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Empty state when no device selected -->
            <TextBlock Grid.Column="2" x:Name="EmptyDetail"
                       Text="Select a device to view details"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Opacity="0.5" FontSize="13"/>
        </Grid>

        <!-- Footer with settings -->
        <Border Grid.Row="2" Padding="16,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tray icon shows:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="TrayDeviceCombo" SelectionChanged="TrayDeviceCombo_SelectionChanged"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Polling interval:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="PollingCombo" SelectionChanged="PollingCombo_SelectionChanged"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Auto-hide icon:" VerticalAlignment="Center"
                               ToolTip="Hide the tray icon while no device is connected. Launch the app again to open settings."/>
                    <ui:ToggleSwitch Grid.Column="1" x:Name="AutoHideToggle"
                                     Content="Hide tray icon when no device is connected"
                                     Checked="AutoHideToggle_Toggled" Unchecked="AutoHideToggle_Toggled"/>
                </Grid>
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Auto-update:" VerticalAlignment="Center"/>
                    <ui:ToggleSwitch Grid.Column="1" x:Name="AutoUpdateToggle"
                                     Checked="AutoUpdateToggle_Toggled" Unchecked="AutoUpdateToggle_Toggled"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
